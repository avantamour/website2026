---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import CredibilityStrip from '@components/home/CredibilityStrip.astro';
import ServicesGrid from '@components/home/ServicesGrid.astro';
import WhoWeWorkWith from '@components/home/WhoWeWorkWith.astro';
import HowWeWork from '@components/home/HowWeWork.astro';
import FeaturedInsights from '@components/home/FeaturedInsights.astro';
import ContactCTA from '@components/home/ContactCTA.astro';
import Testimonials from '@components/content/Testimonials.astro';
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import { BRAND } from '@lib/constants';
---
<BaseLayout
  title={BRAND.name}
  seoTitle="Avant Amour — Ethnographic Research Agency for D2C Brands"
  description={BRAND.defaultDescription}
  jsonLdType="website"
>
  <Hero />
  <CredibilityStrip />
  <ServicesGrid />
  <WhoWeWorkWith />
  <HowWeWork />
  <FeaturedInsights />
  {/* Proof directly before the ask. Cream follows FeaturedInsights' paper;
      ContactCTA's top border separates the two cream sections that follow. */}
  <Section background="cream">
    <Container>
      <Testimonials surface="cream" />
    </Container>
  </Section>
  <ContactCTA />
</BaseLayout>
