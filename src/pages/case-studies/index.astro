---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import EnquiryCTA from '@components/content/EnquiryCTA.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { BRAND } from '@lib/constants';

// Featured first, then studies with a cover image, then newest first: the
// cards without a cover (text-only covers) sit at the end so the grid opens on
// pictures.
const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    Number(Boolean(b.data.cover)) - Number(Boolean(a.data.cover)) ||
    (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0),
);
---
<BaseLayout
  title="Case Studies"
  seoTitle="Qualitative Research Case Studies, India | Avant Amour"
  description="Ethnographic and qualitative research case studies from India — consumer health, household money, urban wellbeing and rural livelihoods."
>
  <section class="bg-cream pt-12 md:pt-16 pb-10 md:pb-14 border-b border-border">
    <Container>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Case Studies' }]} />
      <p class="eyebrow text-teal-700 mt-6">Case Studies</p>
      <h1 class="mt-4 font-display font-medium text-h1 md:text-[3rem] leading-[1.1] tracking-tightest text-ink max-w-3xl">
        What the work looks like, anonymised.
      </h1>
      <p class="mt-6 text-body text-ink-soft max-w-prose">
        Every engagement is confidential. Each case study describes the question, the method, and what we found — without naming the client. Where the work predates Avant Amour, it is {BRAND.founder.firstName}'s prior research.
      </p>
    </Container>
  </section>

  <section class="bg-paper py-12 md:py-20">
    <Container>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {studies.map((s, i) => (
          <li>
            <a href={`/case-studies/${s.slug}/`} class="flex flex-col border border-border bg-paper no-underline hover:border-teal transition-colors h-full">
              {s.data.cover ? (
                <Image
                  src={s.data.cover}
                  alt={s.data.coverAlt ?? ''}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 768px) 560px, calc(100vw - 2rem)"
                  quality={70}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  class="block w-full aspect-[16/9] object-cover"
                />
              ) : (
                <span aria-hidden="true" class="flex w-full aspect-[16/9] items-end bg-cream border-b border-border p-8">
                  <span class="font-display font-medium text-[2rem] md:text-[2.5rem] leading-[1.05] tracking-tightest text-teal-700">{s.data.industry.split(' · ')[0]}</span>
                </span>
              )}
              <div class="flex flex-1 flex-col p-8">
                <p class="eyebrow text-teal-700">{s.data.industry}</p>
                <h2 class="mt-3 font-display font-medium text-h2 leading-[1.15] text-ink">{s.data.title}</h2>
                <p class="mt-3 text-body text-ink-soft">{s.data.description}</p>
                {(s.data.metric || s.data.scope) && (
                  <p class="mt-6 self-start inline-flex items-center gap-2 text-eyebrow uppercase tracking-eyebrow text-teal-700 border border-teal/40 px-3 py-1">
                    {s.data.metric && <span aria-hidden="true">↑</span>}{s.data.metric ?? s.data.scope}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
        {studies.length === 0 && (
          <li class="text-ink-soft">More case studies coming soon. <a href="/contact/" class="underline decoration-teal">Ask for examples on a call.</a></li>
        )}
      </ul>
    </Container>
  </section>

  <EnquiryCTA question="Have a question like one of these?" />
</BaseLayout>
