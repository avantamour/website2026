---
import BaseLayout from '@layouts/BaseLayout.astro';
import ThankYou from '@components/content/ThankYou.astro';
import { BRAND } from '@lib/constants';
---
<BaseLayout
  title="Thank you"
  description={`Thanks for getting in touch — we'll reply within ${BRAND.replyWithin}.`}
  noindex={true}
>
  {/* The Google Ads landing page's own thank-you page (agency request, 5 Oct 2026),
      so ad leads have a conversion URL that /contact/ leads never reach. */}
  <ThankYou formPath="/market-research-company/" />
</BaseLayout>
