---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import FounderVideo from '@components/content/FounderVideo.astro';
import { BRAND } from '@lib/constants';
---
{/* Founder video on the right (owner request, 10 Oct 2026). The "Ethnography."
    signature that used to fill that column now runs as a horizontal band under
    the hero, from md up; it stays decorative (aria-hidden), as before. The
    video keeps lg:mr-20 clear of the right edge so the floating WhatsApp button
    (raised while the consent banner shows) never covers its controls. */}
<section class="bg-cream pt-12 pb-14 md:pt-20 md:pb-16" aria-labelledby="hero-h1">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">Founder-led · Based in India</p>
        <h1 id="hero-h1" class="font-display font-medium text-hero md:text-[4rem] leading-[1.05] tracking-tightest text-ink">
          {BRAND.h1}
        </h1>
        <p class="mt-6 max-w-prose text-body text-ink-soft">
          {BRAND.subLine}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <Button href="/contact/" variant="primary">Talk to Arrpita →</Button>
          <Button href="/methodology/" variant="secondary">See how we work</Button>
        </div>
      </div>

      <figure class="lg:col-span-5 m-0 w-full max-w-[17rem] lg:max-w-[18rem] mx-auto lg:mr-20">
        <div class="border border-border bg-paper p-2">
          <FounderVideo />
        </div>
        <figcaption class="mt-3 text-small text-ink-soft">Meet {BRAND.founder.firstName} · 1 minute</figcaption>
      </figure>
    </div>

    <div aria-hidden="true" class="hidden md:flex items-end justify-between gap-10 mt-14 lg:mt-16 pt-8 border-t border-border">
      <div>
        <p class="eyebrow text-ink-soft mb-3">The signature</p>
        <p class="pb-3 font-display font-medium text-[3.5rem] lg:text-[4.5rem] leading-none tracking-tightest text-ink">
          Ethno<span class="signature-underline">graphy</span><span class="text-yellow ml-0.5">.</span>
        </p>
      </div>
      <p class="max-w-[17rem] text-small text-ink-soft">
        Observation in real settings. Diaries from real days. Interviews where decisions actually happen.
      </p>
    </div>
  </Container>
</section>

<style>
  .signature-underline {
    text-decoration: underline;
    text-decoration-color: #1A9FA5;
    text-decoration-thickness: 4px;
    text-underline-offset: 0.32em;
    text-decoration-skip-ink: auto;
  }
</style>
