---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A captioned image inside content (MDX). Sources live in src/assets and are
 * resized to WebP at build by astro:assets, so originals can be dropped in as-is.
 *
 * - `photo`: photographs get the brand's 10% teal overlay (.image-overlay).
 *   Maps and diagrams do not — the tint would muddy their colours.
 * - `zoom`: text-dense diagrams also link to a full-size copy, because their
 *   small print is not readable at the 68ch prose width.
 * - The figure is capped at the image's own width, so nothing is upscaled.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  photo?: boolean;
  zoom?: boolean;
}
const { src, alt, caption, credit, photo = false, zoom = false } = Astro.props;
// Portrait photos would otherwise fill more than a screen (the 693×1039 rolling-machine
// shot rendered 1037px tall), so cap their height at ~640px by narrowing them.
// Diagrams keep their full width: their small print needs it.
const maxWidth = photo && src.height > src.width ? Math.round((src.width * 640) / src.height) : src.width;
const widths = [400, 800, 1200].filter((w) => w < src.width).concat(src.width);
const sizes = `(min-width: 800px) min(729px, ${maxWidth}px), 100vw`;
const full = zoom ? await getImage({ src, format: 'webp', width: src.width }) : undefined;
---
<figure class="aa-figure" style={`max-width: ${maxWidth}px`}>
  <div class:list={['border border-border bg-paper', { 'image-overlay': photo }]}>
    {full ? (
      <a href={full.src} target="_blank" rel="noopener" class="block no-underline">
        <Image src={src} alt={alt} widths={widths} sizes={sizes} class="block w-full h-auto" />
      </a>
    ) : (
      <Image src={src} alt={alt} widths={widths} sizes={sizes} class="block w-full h-auto" />
    )}
  </div>
  {(caption || credit || full) && (
    <figcaption>
      {caption}
      {full && <> <a href={full.src} target="_blank" rel="noopener">Open full size</a></>}
      {credit && <span class="block">{credit}</span>}
    </figcaption>
  )}
</figure>
